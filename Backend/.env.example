# Server
NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/health_ai_tracker

# Auth — use a long random string in production (e.g. openssl rand -base64 32)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=10
# Optional separate HMAC key for OTP storage (defaults to JWT_SECRET)
# OTP_PEPPER=

# Email: in development, default is console (prints OTP to the terminal)
# Set EMAIL_TRANSPORT=smtp to send real mail (required defaults in production)
EMAIL_TRANSPORT=console

# SMTP (when EMAIL_TRANSPORT=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Health AI Tracker <noreply@example.com>"

# CORS (optional)
# CORS_ORIGIN=http://localhost:3000

# Rate limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# AWS S3 (report uploads — use IAM user with least privilege: PutObject, GetObject, DeleteObject on bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
# Optional: presigned download URL TTL after upload (seconds)
# PRESIGNED_URL_TTL_SECONDS=3600
# Optional: set true only if your bucket/IAM expects explicit SSE-S3 on PutObject
# S3_PUT_SSE_AES256=false

# Google Cloud Vision (OCR) — use EITHER a service-account JSON path OR inline fields
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_VISION_PROJECT_ID=my-gcp-project
# GOOGLE_VISION_CLIENT_EMAIL=vision-sa@my-gcp-project.iam.gserviceaccount.com
# GOOGLE_VISION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# OpenAI (medical report analysis — optional until you call /api/ai/analyze)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=120000
# OPENAI_MAX_INPUT_CHARS=28000
# OPENAI_MAX_RETRIES=3
